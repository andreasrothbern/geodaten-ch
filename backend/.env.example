# Backend Environment Variables
# ==============================

# Cache Datenbank Pfad
CACHE_DB_PATH=cache.db

# Frontend URL für CORS
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DuckDB Migration (NEU 12.01.2026)
# =============================================================================

# DuckDB statt SQLite für building_3d.db verwenden
# Aktiviert bessere Parallelität und schnelleren Bulk-Import
USE_DUCKDB=false

# 3D-Layer aus swissBUILDINGS3D laden (Floor, Wall, Roof)
# Benötigt mehr Speicher, liefert aber präzisere 3D-Daten
LOAD_3D_LAYERS=false

# Dachwinkel aus 3D-Geometrie berechnen (statt Heuristik)
# Nur relevant wenn LOAD_3D_LAYERS=true
CALC_ROOF_FROM_3D=false

# DuckDB-spezifische Konfiguration
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=512MB
